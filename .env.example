# ─────────────────────────────────────────────────────────────────────────
# NexusData configuration template.
#
# Copy to `.env` and fill in real values. NEVER commit the real `.env` — it is
# gitignored and must stay out of version control. Generate strong secrets:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# ─────────────────────────────────────────────────────────────────────────

# Database (MySQL/MariaDB). Use a dedicated least-privilege DB user.
DATABASE_URL=mysql+pymysql://USER:PASSWORD@DB_HOST:3306/barotrauma

# Server
APP_NAME=Nexus Data
APP_VERSION=1.0
# MUST be false in production (enables Secure cookies, disables autoreload,
# hides Swagger docs and verbose errors). true only for local development.
DEBUG=false
SERVER_HOST=0.0.0.0
# Internal backend port — proxy_server.py owns the public port and forwards here.
SERVER_PORT=8001
# Keep at 1 (in-process Discord bot needs to share the web process).
UVICORN_WORKERS=1

# CORS — explicit public origin(s). Never "*" together with credentials.
# List EVERY domain the site is reachable on (see EXTRA_ALLOWED_HOSTS below
# if there's more than one entry point), comma-separated or JSON array.
CORS_ORIGINS=["https://your-domain.example"]
CORS_CREDENTIALS=true
CORS_METHODS=["*"]
CORS_HEADERS=["*"]

# Security secrets — generate unique random values, keep out of git.
SECRET_KEY=CHANGE_ME_generate_a_long_random_value
# Ingest key used by the Barotrauma game-server plugin (X-API-Key / api_key).
API_KEY=CHANGE_ME_generate_a_long_random_value
# Optional: separate read-only key for external "client" integrations
# (world-state / warehouse export). Leave empty to keep those endpoints closed.
CLIENT_API_KEY=

# Optional AsperAIDispatcher bridge. Both values are required to enable it.
# Use the AI service's POST /api/v1/dispatcher/messages endpoint.
AI_DISPATCHER_URL=http://127.0.0.1:8000/api/v1/dispatcher/messages
AI_DISPATCHER_API_KEY=
AI_DOSSIER_URL=https://213.108.170.48:8000/v1/chat/completions
AI_DOSSIER_API_KEY=
AI_DOSSIER_TLS_CA_FILE=
AI_DOSSIER_TIMEOUT_SECONDS=180
AI_DOSSIER_MODEL=qwen2.5-3b-instruct
AI_DOSSIER_ACTIVE_DAYS=30
AI_DOSSIER_DAILY_LIMIT=10
AI_DOSSIER_SCHEDULE_HOUR=4
AI_DISPATCHER_TIMEOUT_SECONDS=60
# Fallback for WorldStateStreamer payloads that omit server_name.
WORLD_DEFAULT_SERVER_NAME=ASPER1
# Large non-abyss creatures visible beyond Yasa's 250 m identification zone.
AI_LARGE_CREATURE_SPECIES=Bonethresher,Tigerthresher,Moloch,Molochblack,Hammerhead,Hammerheadgold,Hammerheadmatriarch,Watcher,Spineling_giant,Crawlerbroodmother,Carrier
# Always ignored, even if a species is accidentally present in the allowlist.
AI_ABYSS_CREATURE_SPECIES=Endworm,Charybdis,Latcher,Doomworm
# Keep staggered members of one nearby same-species group under one contact.
AI_CREATURE_ALERT_TRACKING_SECONDS=600
AI_CREATURE_ALERT_TRACKING_DISTANCE_METERS=300

# Discord OAuth (site login). From the Discord Developer Portal application.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=https://your-domain.example/auth/discord/callback
# Optional: extra hostnames the site is ALSO directly reachable on (e.g. a
# second entry point bypassing the main proxy) besides the one in
# DISCORD_REDIRECT_URI above. Comma-separated or JSON array, e.g.
# EXTRA_ALLOWED_HOSTS=["second-domain.example"]
# Each one must ALSO be added as its own Redirect URI
# (https://<host>/auth/discord/callback) in the Discord Developer Portal —
# Discord rejects logins to any URI that isn't explicitly registered there.
EXTRA_ALLOWED_HOSTS=

# Discord Bot (runs in-process — see discord_bot/bot.py). Bot token + guild id.
DISCORD_BOT_TOKEN=
GUILD_ID=

# Steam Web API key (optional — player avatar auto-fetch).
STEAM_API_KEY=

# SFTP log directories (optional — remote server log tail).
SFTP_SERVER_1_LOGS_DIR=
SFTP_SERVER_2_LOGS_DIR=
# IANA timezone of the wall-clock timestamps inside Barotrauma text logs.
# Per-server values are selected by SFTP_SERVER_1_NAME/SFTP_SERVER_2_NAME and
# are optional; an empty value falls back to LOGS_DEFAULT_TIMEZONE.
LOGS_DEFAULT_TIMEZONE=Europe/Moscow
SFTP_SERVER_1_LOGS_TIMEZONE=
SFTP_SERVER_2_LOGS_TIMEZONE=

# Durable ticket evidence. Incoming Discord files are mirrored here before a
# ticket channel can be deleted. The default `uploads/...` path is included in
# encrypted backups below. Values are bytes except the timeout (seconds).
TICKET_ATTACHMENTS_DIR=uploads/ticket_attachments
TICKET_ATTACHMENT_MAX_BYTES=209715200
TICKET_ATTACHMENT_MESSAGE_MAX_BYTES=419430400
# 2 GiB per ticket and 50 GiB for all durable ticket evidence. Set either to
# 0 only if a filesystem-level quota is configured outside the application.
TICKET_ATTACHMENT_TICKET_QUOTA_BYTES=2147483648
TICKET_ATTACHMENT_GLOBAL_QUOTA_BYTES=53687091200
TICKET_ATTACHMENT_DOWNLOAD_TIMEOUT_SECONDS=120
# Crash leftovers are reclaimed only after this safety window (24 hours).
TICKET_ATTACHMENT_ORPHAN_GRACE_SECONDS=86400
TICKET_WEB_UPLOAD_MAX_BYTES=26214400
TICKET_WEB_UPLOAD_MAX_FILES=10
# Best-effort startup/periodic migration of open Discord ticket history. Work
# is deliberately paged and throttled to avoid Discord rate-limit bursts.
TICKET_HISTORY_BACKFILL_ENABLED=true
TICKET_HISTORY_BACKFILL_INTERVAL_SECONDS=900
TICKET_HISTORY_BACKFILL_CHANNELS_PER_RUN=4
TICKET_HISTORY_BACKFILL_MESSAGES_PER_CHANNEL=250
TICKET_HISTORY_BACKFILL_PAUSE_SECONDS=0.10

# Encrypted off-site backups (optional). Dedicated BACKUP_* settings are
# preferred. Password auth is supported; a restricted non-root account remains
# strongly recommended.
BACKUP_ENABLED=false
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION_COUNT=14
BACKUP_SFTP_HOST=213.108.170.48
BACKUP_SFTP_PORT=22
BACKUP_SFTP_USERNAME=nexusbackup
BACKUP_SFTP_PASSWORD=
BACKUP_SFTP_PRIVATE_KEY_PATH=/home/container/.ssh/nexus_backup
BACKUP_SFTP_PRIVATE_KEY_PASSPHRASE=
# Pin the server key after verifying its SHA256 fingerprint out-of-band.
BACKUP_SFTP_KNOWN_HOSTS_PATH=/home/container/.ssh/nexus_backup_known_hosts
# With deploy/provision_backup_sftp.sh this path is seen inside the chroot.
BACKUP_SFTP_REMOTE_DIR=/data
# Generate once, store outside the backup server too, and never lose it:
# python -c "import os,base64; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
BACKUP_ENCRYPTION_KEY=
BACKUP_INCLUDE_DATABASE=true
# Optional dedicated least-privilege MySQL/MariaDB dump account. Empty uses
# DATABASE_URL. URL-encode special characters in the username/password.
BACKUP_DATABASE_URL=
BACKUP_INCLUDE_LOG_INDEX=true
# Site logs and uploads are included; .env/private keys are always excluded.
# Add the exact extra log paths here when they are known.
BACKUP_INCLUDE_PATHS=config,uploads,logs
BACKUP_MYSQLDUMP_BINARY=mysqldump
BACKUP_COMMAND_TIMEOUT_SECONDS=1800
BACKUP_TEMP_DIR=

# Compact password-only profile. A non-empty SFTP_PASSWORD selects all four
# values below unless BACKUP_SFTP_PASSWORD is explicitly set.
# BACKUP_ENCRYPTION_KEY is still required.
SFTP_IP=
SFTP_PORT=22
SFTP_USER=
SFTP_PASSWORD=

# Discord channel id for sub-projects publishing (optional).
SUB_PROJECTS_DISCORD_CHANNEL_ID=

# ONLYOFFICE document server (optional — document editing).
ONLYOFFICE_DOCUMENT_SERVER_URL=
ONLYOFFICE_CALLBACK_BASE_URL=
ONLYOFFICE_JWT_SECRET=

# Pterodactyl panel API (optional — department/sub-project test-server control).
PTERODACTYL_PANEL_URL=
PTERODACTYL_API_KEY=
SUB_PROJECTS_TEST_SERVER_UUID=

# Обновление кода из git (консольная команда `update`).
# GIT_UPDATE_TOKEN нужен ТОЛЬКО для приватного репозитория по HTTPS:
# токен уходит заголовком Authorization на хост remote'а и никуда не
# записывается. Для ssh-remote авторизация идёт ключом, токен не нужен.
GIT_UPDATE_REPO_DIR=
# Адрес репозитория — нужен только для `update bootstrap` (развернуть код
# там, где рабочей копии ещё нет). Когда она есть, адрес берётся из remote.
GIT_UPDATE_REPO_URL=
GIT_UPDATE_REMOTE=origin
GIT_UPDATE_BRANCH=
GIT_UPDATE_TOKEN=
GIT_UPDATE_TOKEN_USERNAME=x-access-token
GIT_UPDATE_BUILD_FRONTEND=true
GIT_UPDATE_RESTART_BACKEND=false
# Ветка с ГОТОВОЙ сборкой фронтенда (её наполняет workflow
# .github/workflows/frontend-dist.yml). Задана — update скачивает dist
# оттуда, и npm на сервере не нужен вообще. Обычно: frontend-dist
GIT_UPDATE_FRONTEND_DIST_BRANCH=
# Явный путь к npm — нужен только при ЛОКАЛЬНОЙ сборке (когда ветка выше не
# задана), если она падает с «Команда не найдена: npm». Типично на
# Pterodactyl: Node.js стоит через nvm, а PATH процесса приложения его не
# видит, потому что это не login-shell.
GIT_UPDATE_NPM_PATH=
