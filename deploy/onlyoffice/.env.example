# Copy this file to `.env` in the same directory and fill in a real secret.
# Generate one with: openssl rand -hex 32
#
# This EXACT value must also be set as `ONLYOFFICE_JWT_SECRET` (or
# `onlyoffice_jwt_secret` in config.py) on the NexusData backend — both
# sides sign/verify with the same secret.
ONLYOFFICE_JWT_SECRET=change-me
