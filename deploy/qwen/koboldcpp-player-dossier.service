[Unit]
Description=KoboldCpp Qwen player dossier API
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=koboldcpp
Group=koboldcpp
EnvironmentFile=/etc/koboldcpp/player-dossier.env
ExecStart=/opt/models/qwen25/koboldcpp-linux-x64 \
  --model /opt/models/qwen25/qwen25-3b-q4_k_m.gguf \
  --usecuda \
  --contextsize 8192 \
  --gpulayers 35 \
  --threads 4 \
  --host 0.0.0.0 \
  --port 8000 \
  --parallelrequests 1 \
  --password ${KOBOLD_PASSWORD} \
  --ssl /etc/koboldcpp/player-dossier.crt /etc/koboldcpp/player-dossier.key \
  --genlimit 700 \
  --maxrequestsize 2 \
  --ratelimit 1 \
  --quiet
Restart=on-failure
RestartSec=5
RuntimeDirectory=koboldcpp
WorkingDirectory=/run/koboldcpp
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/run/koboldcpp

[Install]
WantedBy=multi-user.target
