<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <PropertyGroup>
    <!-- The repository normally lives under LocalMods, while a git worktree
         lives beside LocalMods. Resolve both layouts without manual junctions. -->
    <ConcentusProject>../../../LuaCsForBarotrauma/Libraries/Concentus/CSharp/Concentus/Concentus.NetStandard.csproj</ConcentusProject>
    <ConcentusProject Condition="!Exists('$(ConcentusProject)')">../../../../LocalMods/LuaCsForBarotrauma/Libraries/Concentus/CSharp/Concentus/Concentus.NetStandard.csproj</ConcentusProject>
    <ConcentusProject Condition="!Exists('$(ConcentusProject)') and Exists('../../../../LuaCsForBarotrauma/Libraries/Concentus/CSharp/Concentus/Concentus.NetStandard.csproj')">../../../../LuaCsForBarotrauma/Libraries/Concentus/CSharp/Concentus/Concentus.NetStandard.csproj</ConcentusProject>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="$(ConcentusProject)" Condition="Exists('$(ConcentusProject)')" />
  </ItemGroup>
</Project>
